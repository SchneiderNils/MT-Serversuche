# Nach .env kopieren und ausfüllen:  cp config.example.env .env
# .env gehört nicht ins Git - sie enthält das Bot-Token.

# --- Pflicht --------------------------------------------------------------- #
DISCORD_TOKEN=

# Server-ID (Rechtsklick auf den Server -> ID kopieren, Entwicklermodus nötig).
# Gesetzt: Slash-Commands sind sofort da. Leer: global, bis zu 1 h Verzögerung.
DISCORD_GUILD_ID=

# --- Poll ------------------------------------------------------------------ #
POLL_INTERVAL_MINUTES=5
PROVIDERS=hetzner,pph

# --- Ping ------------------------------------------------------------------ #
# Wer gepingt wird, wenn ein Treffer gemeldet wird und der Watch bzw. Alarm
# keine eigene Erwähnung hat (Option "erwähnen" bei /watch add, /alarm setzen).
# Benutzer: die ID (Rechtsklick -> ID kopieren) oder <@123456789>
# Rolle:    <@&123456789>          Alle im Kanal: @here
# Leer = es wird nur gepingt, wo eine Erwähnung ausdrücklich gesetzt wurde.
DEFAULT_MENTION=

# --- Preisdarstellung ------------------------------------------------------ #
# Jede Angebotskarte zeigt beide Preise: den unten gewählten fett, den anderen
# daneben. Diese Einstellung legt fest, worauf sich die *Zahlen* beziehen, mit
# denen gerechnet wird - Preisfilter, Zielpreise der Alarme und Tier-Deckel.
# net = Nettopreise wie von den APIs geliefert, gross = inkl. 19 % USt.
PRICE_MODE=net
# Hetzner-IPv4-Monatspreis mit einrechnen (1 = ja)
INCLUDE_IP=0

# --- Alert-Schwellen ------------------------------------------------------- #
# Ein Preisrutsch wird erst ab einem dieser Werte gemeldet, damit die
# Cent-Schritte der Hetzner-Auktion keinen Dauerspam auslösen.
ALERT_DROP_PCT=3
ALERT_DROP_ABS=2

# --- Datenhaltung ---------------------------------------------------------- #
DB_PATH=serversuche.db
SPECS_PATH=server_specs.json
# Verschwundene Angebote nach N Tagen samt Preisreihe löschen (0 = nie)
PRUNE_AFTER_DAYS=60

LOG_LEVEL=INFO
